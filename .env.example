# App
ENV=development
LOG_LEVEL=INFO
# Optional API auth (if set, requests must send Authorization: Bearer <token>)
API_AUTH_TOKEN=

# Database
DATABASE_URL=sqlite:///./app.db
DEFAULT_TIMEZONE=UTC

# Gemini (content generation for Twitter)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Composio (Twitter/X publishing)
COMPOSIO_API_KEY=
# User ID in Composio for the user whose Twitter account is connected (defaults to "default")
COMPOSIO_USER_ID=default

